{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luca",
  "version": "0.5.0",
  "identifier": "net.mediafranca.luca",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "npm run vendor",
    "beforeBuildCommand": "npm run vendor"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Luca",
        "width": 960,
        "height": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: https:; font-src 'self' data:; connect-src 'self' https://cdn.jsdelivr.net",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "MediaFranca · Herbert Spencer González",
    "homepage": "https://github.com/mediafranca/luca",
    "copyright": "© 2026 Herbert Spencer González",
    "license": "EUPL-1.2",
    "category": "Productivity",
    "shortDescription": "Editor Markdown de escritorio",
    "longDescription": "Luca es una iniciativa de MediaFranca creada por Herbert Spencer: un editor Markdown local para pensar y escribir con archivos propios.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "luca.desktop"
      }
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Documento Markdown",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ]
  }
}
