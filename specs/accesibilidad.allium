-- allium: 3
-- accesibilidad.allium — acceso equivalente a las superficies de Luca

use "./luca.allium" as luca

surface InterfazAccesible {
    facing autor: luca/Autor

    @guarantee OperacionPorTeclado
        -- Pestañas, comandos, preferencias y acciones principales se pueden
        -- recorrer y activar sin un dispositivo apuntador.

    @guarantee FocoPerceptible
        -- Todo control enfocado presenta un indicador visible. Al cerrar una
        -- superficie que se abrió sobre la app —diálogo, paleta o la página de
        -- preferencias— el foco vuelve al control que la abrió, y Esc la cierra.

    @guarantee SemanticaDeAsistencia
        -- Pestañas, regiones, diálogos, listas de selección y controles exponen
        -- roles y nombres que permiten comprender su propósito con tecnología
        -- de asistencia, y señalan cuál de sus elementos está seleccionado.
}
