-- allium: 3
-- confianza.allium — migración local y diagnóstico compartible

use "./luca.allium" as luca

rule MigrarPreferencias {
    when: AutorIniciaLuca(autor)

    @guarantee MigracionIncremental
        -- Luca aplica en orden las migraciones anteriores a la versión de
        -- esquema actual y registra esa versión una sola vez.

    @guarantee PreferenciasDesconocidas
        -- Una migración conserva claves que no reconoce y no borra documentos.
}

rule ExportarDiagnostico {
    when: AutorExportaDiagnostico(autor)

    @guarantee DatosTecnicos
        -- El resultado identifica versión, plataforma, esquema, capacidades y
        -- conteos de pestañas por estado y formato.

    @guarantee SinContenidoSensible
        -- El resultado no incluye contenido, nombres o rutas de documentos,
        -- recientes, URL de la wiki, cookies, credenciales ni tokens de diseño.
}

rule EditarDiseno {
    when: AutorEditaDiseno(autor)

    @guarantee DisenoActivoExplicito
        -- Los valores gráficos —tipografías, medidas y los colores de los temas
        -- claro y oscuro— se guardan en diseños con nombre. La interfaz señala
        -- cuál está activo y toda edición gráfica recae en ése.

    @guarantee ImportarAnade
        -- Importar un diseño lo añade a la lista con su nombre y lo deja activo;
        -- no sobrescribe el que está en uso. Un nombre repetido se numera.

    @guarantee SoloTokensConocidos
        -- De un archivo importado se aceptan únicamente nombres de token
        -- conocidos, y valores que no puedan cerrar la declaración e introducir
        -- reglas propias.

    @guarantee SiempreQuedaUnDiseno
        -- Eliminar un diseño pide confirmación y nunca deja la lista vacía.

    @guidance
        -- El esquema claro u oscuro es una preferencia del dispositivo: no
        -- pertenece al diseño ni viaja en el archivo exportado.
}

surface Confianza {
    facing autor: luca/Autor

    provides:
        AutorIniciaLuca(autor)
        AutorExportaDiagnostico(autor)
        AutorEditaDiseno(autor)
}
